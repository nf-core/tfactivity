params.pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/tfactivity/'

process {
    withName: BEDTOOLS_MERGE {
        ext.args = {"-d ${meta.max_peak_gap}"}
    }

    withName: BEDTOOLS_SUBTRACT {
        ext.prefix = {"${meta.id}.subtracted"}
    }
}
