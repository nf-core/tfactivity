nextflow_workflow {

    name "Test Workflow DYNAMITE"
    script "subworkflows/local/dynamite/main.nf"
    workflow "DYNAMITE"

    test("Should run without failures") {

        config "./nextflow.config"

        when {
            workflow {
                """
                input[0] = Channel.value([
                    [id: "test", condition1: "L1", condition2: "L10"],
                    file(params.pipelines_testdata_base_path + '/intermediates/deseq2/L1:L10.deseq2.results.tsv', checkIfExists: true)
                ])
                input[1] = Channel.value([
                    [id: "test", condition1: "L1", condition2: "L10"],
                    file(params.pipelines_testdata_base_path + '/intermediates/stare/L1:L10_chromHMM_promoters.tsv', checkIfExists: true)
                ])
                input[2] = 3
                input[3] = 6
                input[4] = 0.1
                input[5] = false
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

    test("Should run without failures - stub") {

        options "-stub"
        config "./nextflow.config"

        when {
            workflow {
                """
                input[0] = Channel.value([
                    [id: "test", condition1: "L1", condition2: "L10"],
                    file(params.pipelines_testdata_base_path + '/intermediates/deseq2/L1:L10.deseq2.results.tsv', checkIfExists: true)
                ])
                input[1] = Channel.value([
                    [id: "test", condition1: "L1", condition2: "L10"],
                    file(params.pipelines_testdata_base_path + '/intermediates/stare/L1:L10_chromHMM_promoters.tsv', checkIfExists: true)
                ])
                input[2] = 3
                input[3] = 6
                input[4] = 0.1
                input[5] = false
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

}
