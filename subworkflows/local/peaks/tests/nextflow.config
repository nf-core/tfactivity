process {
    withName: "PEAKS:CLEAN_BED" {
        ext.args = {"'{print \$1 \"\\t\" \$2 \"\\t\" \$3 \"\\t\" \$4 \"\\t\" \$5 \"\\t\" \$6}'"}
        ext.prefix = {"${meta.id}.clean"}
        ext.suffix = "bed"
    }

    withName: "PEAKS:FOOTPRINTING:BEDTOOLS_MERGE" {
        ext.args = {"-d ${meta.max_peak_gap}"}
        ext.prefix = {"${meta.id}.merged"}
    }

    withName: "PEAKS:MERGE_SAMPLES:ANNOTATE_SAMPLES" {
        ext.args = {"'{print \$0 \"\\t\" \"${meta.id}\"}'"}
        ext.prefix = {"${meta.id}.annotated"}
    }

    withName: "PEAKS:MERGE_SAMPLES:CONCAT_SAMPLES" {
        ext.prefix = {"${meta.id}.concatenated"}
    }

    withName: "PEAKS:MERGE_SAMPLES:BEDTOOLS_SORT" {
        ext.prefix = {"${meta.id}.sorted"}
    }

    withName: "PEAKS:MERGE_SAMPLES:BEDTOOLS_MERGE" {
        ext.args = "-c 1 -o count"
        ext.prefix = {"${meta.id}.merged"}
    }

    withName: "PEAKS:MERGE_SAMPLES:FILTER_MIN_OCCURRENCE" {
        ext.args = {"'\$NF >= ${params.min_peak_occurrence}'"}
    }

    withName: "PEAKS:MERGE_SAMPLES:CLEAN_BED" {
        ext.args = "'{print \$1 \"\\t\" \$2 \"\\t\" \$3}'"
        ext.prefix = {"${meta.id}.clean"}
        ext.suffix = "bed"
    }

    withName: "PEAKS:ROSE:FILTER_CONVERT_GTF" {
        ext.args = {"'BEGIN {OFS = \"\\t\"} \$3 == \"transcript\" {print \$1, \$4-1, \$4, \$1 \":\" \$4-1 \"-\" \$4, \$6, \$7}'"}
        ext.suffix = "bed"
    }

    withName: "PEAKS:ROSE:SORT_CHROM_SIZES" {
        ext.args = "-V -k1,1 -k2,2n"
        ext.prefix = {"${meta.id}_sorted"}
        ext.suffix = "fa.fai"
    }

    withName: "PEAKS:ROSE:CONSTRUCT_TSS" {
        ext.args = {"-b ${params.rose_tss_window}"}
        ext.prefix = "tss"
    }

    withName: "PEAKS:ROSE:FILTER_PREDICTIONS" {
        ext.args = "-A -f 1"
        ext.prefix = {"${meta.id}_filtered"}
    }

    withName: "PEAKS:ROSE:STITCHING" {
        ext.args = {"-d ${params.rose_stitching_window}"}
        ext.prefix = {"${meta.id}_stitched"}
    }

    withName: "PEAKS:ROSE:TSS_OVERLAP" {
        ext.args = "-c"
        ext.prefix = {"${meta.id}_tss-overlap-counts"}
    }

    withName: "PEAKS:ROSE:FILTER_OVERLAPS" {
        ext.args = {"'BEGIN {OFS = \"\\t\"} \$NF >= 2 {print \$1, \$2, \$3}'"}
        ext.prefix = {"${meta.id}_overlap"}
    }

    withName: "PEAKS:ROSE:UNSTITCHED_REGIONS" {
        ext.args = "-F 1"
        ext.prefix = {"${meta.id}_original_regions"}
    }

    withName: "PEAKS:ROSE:CONCAT_AND_SORT" {
        ext.prefix = {"${meta.id}_stitched"}
        ext.args = "-k1,1 -k2,2n"
        ext.suffix = "bed"
    }
}