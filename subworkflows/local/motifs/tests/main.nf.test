nextflow_workflow {

    name "Test Workflow MOTIFS"
    script "subworkflows/local/motifs/main.nf"
    workflow "MOTIFS"

    test("Should run with input motifs") {

        when {
            workflow {
                """
                input[0] = file(params.pipelines_testdata_base_path + '/reference/motifs.jaspar', checkIfExists: true)
                input[1] = [
                    [id: 'test'],
                    file(params.pipelines_testdata_base_path + '/intermediates/tf_list.txt', checkIfExists: true)
                ]
                input[2] = null
                input[3] = false
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

    test("Should run with input motifs - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = file(params.pipelines_testdata_base_path + '/reference/motifs.jaspar', checkIfExists: true)
                input[1] = [
                    [id: 'test'],
                    file(params.pipelines_testdata_base_path + '/intermediates/tf_list.txt', checkIfExists: true)
                ]
                input[2] = null
                input[3] = false
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

    test("Should run with taxon id") {

        when {
            workflow {
                """
                input[0] = null
                input[1] = [
                    [id: 'test'],
                    file(params.pipelines_testdata_base_path + '/intermediates/tf_list.txt', checkIfExists: true)
                ]
                input[2] = '9606'
                input[3] = false
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

    test("Should run with taxon id - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = null
                input[1] = [
                    [id: 'test'],
                    file(params.pipelines_testdata_base_path + '/intermediates/tf_list.txt', checkIfExists: true)
                ]
                input[2] = '9606'
                input[3] = false
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

    test("Should run with input motifs (filtering duplicates)") {

        when {
            workflow {
                """
                input[0] = file(params.pipelines_testdata_base_path + '/reference/motifs.jaspar', checkIfExists: true)
                input[1] = [
                    [id: 'test'],
                    file(params.pipelines_testdata_base_path + '/intermediates/tf_list.txt', checkIfExists: true)
                ]
                input[2] = null
                input[3] = true
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

    test("Should run with input motifs (filtering duplicates) - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = file(params.pipelines_testdata_base_path + '/reference/motifs.jaspar', checkIfExists: true)
                input[1] = [
                    [id: 'test'],
                    file(params.pipelines_testdata_base_path + '/intermediates/tf_list.txt', checkIfExists: true)
                ]
                input[2] = null
                input[3] = true
                """
