nextflow_process {

    name "Test Process LEARN_MODEL"
    script "modules/local/chromhmm/learn_model/main.nf"
    process "LEARN_MODEL"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = [
                    [id: "chromHMM"],
                    [
                        file(params.pipelines_testdata_base_path + '/intermediates/chromHMM/L10_chr1_binary.txt', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/intermediates/chromHMM/p6_chr1_binary.txt', checkIfExists: true)
                    ]
                ]
                input[1] = 4
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should run without failures - stub") {
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [id: "chromHMM"],
                    [
                        file(params.pipelines_testdata_base_path + '/intermediates/chromHMM/L10_chr1_binary.txt', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/intermediates/chromHMM/p6_chr1_binary.txt', checkIfExists: true)
                    ]
                ]
                input[1] = 4
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
