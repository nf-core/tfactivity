nextflow_process {

    name "Test Process COMBINE_COUNTS"
    script "modules/local/counts/combine/main.nf"
    process "COMBINE_COUNTS"

    setup {
        run("PREPARE_GENOME") {
            script "../../../../../subworkflows/local/prepare_genome"
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + '/reference/chr1.fa.gz', checkIfExists: true)
                input[1] = file(params.pipelines_testdata_base_path + '/reference/chr1.gtf.gz', checkIfExists: true)
                """
            }
        }
    }

    test("Should run with full count matrix") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'test'],
                    file(params.pipelines_testdata_base_path + '/rna-seq/combined.csv', checkIfExists: true)
                ]
                input[1] = Channel.empty()
                input[2] = PREPARE_GENOME.out.gene_map
                input[3] = 'sum'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should run with full count matrix - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'test'],
                    file(params.pipelines_testdata_base_path + '/rna-seq/combined.csv', checkIfExists: true)
                ]
                input[1] = Channel.empty()
                input[2] = PREPARE_GENOME.out.gene_map
                input[3] = 'sum'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should run with split matrix") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'test'],
                    file(params.pipelines_testdata_base_path + '/rna-seq/Gene_id.txt', checkIfExists: true)
                ]
                input[1] = [
                    ['L1-WT1', 'L1-WT2', 'L1-WT4', 'L10-WT1', 'L10-WT2', 'L10-WT3', 'L10-WT4', 'p6-WT1', 'p6-WT2', 'p6-WT4'],
                    [
                        file(params.pipelines_testdata_base_path + '/rna-seq/L1/L1_WT1-count.txt', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/rna-seq/L1/L1_WT2-count.txt', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/rna-seq/L1/L1_WT4-count.txt', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/rna-seq/L10/L10_WT1-count.txt', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/rna-seq/L10/L10_WT2-count.txt', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/rna-seq/L10/L10_WT3-count.txt', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/rna-seq/L10/L10_WT4-count.txt', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/rna-seq/p6/p6_WT1-count.txt', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/rna-seq/p6/p6_WT2-count.txt', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/rna-seq/p6/p6_WT4-count.txt', checkIfExists: true),
                    ]
                ]
                input[2] = PREPARE_GENOME.out.gene_map
                input[3] = 'sum'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
