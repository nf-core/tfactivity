nextflow_process {

    name "Test Process FILTER_GENES"
    script "modules/local/counts/filter_genes/main.nf"
    process "FILTER_GENES"

    setup {
        run("PREPARE_GENOME") {
            script "../../../../../subworkflows/local/prepare_genome"
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + '/reference/chr1.fa.gz', checkIfExists: true)
                input[1] = file(params.pipelines_testdata_base_path + '/reference/chr1.gtf.gz', checkIfExists: true)
                """
            }
        }

        run("COMBINE_COUNTS") {
            script "../../combine"
            process {
                """
                input[0] = [
                    [ id: 'test'],
                    file(params.pipelines_testdata_base_path + '/rna-seq/combined.csv', checkIfExists: true)
                ]
                input[1] = Channel.empty()
                input[2] = PREPARE_GENOME.out.gene_map
                input[3] = 'sum'
                """
            }
        }

        run("CALCULATE_TPM") {
            script "../../calculate_tpm"
            process {
                """
                input[0] = COMBINE_COUNTS.out.counts
                input[1] = PREPARE_GENOME.out.gene_lengths
                input[2] = PREPARE_GENOME.out.gene_map
                """
            }
        }
    }

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = COMBINE_COUNTS.out.counts
                input[1] = CALCULATE_TPM.out.tpm
                input[2] = 10
                input[3] = 1
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should run without failures - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = COMBINE_COUNTS.out.counts
                input[1] = CALCULATE_TPM.out.tpm
                input[2] = 10
                input[3] = 1
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
