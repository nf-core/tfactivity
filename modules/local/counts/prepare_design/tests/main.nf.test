nextflow_process {

    name "Test Process PREPARE_DESIGN"
    script "modules/local/counts/prepare_design/main.nf"
    process "PREPARE_DESIGN"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'test'],
                    file(params.pipelines_testdata_base_path + '/samplesheet/samplesheet_rnaseq.csv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should run without failures - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'test'],
                    file(params.pipelines_testdata_base_path + '/samplesheet/samplesheet_rnaseq.csv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
