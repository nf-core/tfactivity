nextflow_process {

    name "Test Process RUN_FIMO"
    script "modules/local/fimo/run_fimo/main.nf"
    process "RUN_FIMO"

    setup {
        run("PREPARE_GENOME") {
            script "../../../../../subworkflows/local/prepare_genome"
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + '/reference/chr1.fa.gz', checkIfExists: true)
                input[1] = file(params.pipelines_testdata_base_path + '/reference/chr1.gtf.gz', checkIfExists: true)
                """
            }
        }

        run("BEDTOOLS_GETFASTA") {
            script "../../../../nf-core/bedtools/getfasta"
            process {
                """
                input[0] = [
                    [id: 'test'],
                    file(params.pipelines_testdata_base_path + '/intermediates/chromHMM/promoter/L10.bed', checkIfExists: true)
                ]
                input[1] = PREPARE_GENOME.out.fasta.map { _meta, f -> f }
                """
            }
        }

        run("CONVERT_MOTIFS") {
            script "../../../motifs/convert_motifs"
            process {
                """
                input[0] = [
                    [ id: 'test' ],
                    file(params.pipelines_testdata_base_path + '/reference/motifs.jaspar', checkIfExists: true),
                    'jaspar'
                ]
                input[1] = 'meme'
                """
            }
        }

        run("FILTER_MOTIFS") {
            script "../../../fimo/filter_motifs"
            process {
                """
                input[0] = [
                    [ id: 'test' ],
                    file(params.pipelines_testdata_base_path + '/intermediates/ranking/tf_across_assays.tsv', checkIfExists: true)
                ]
                input[1] = CONVERT_MOTIFS.out.converted
                """
            }
        }
    }

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = BEDTOOLS_GETFASTA.out.fasta.combine(FILTER_MOTIFS.out.motifs.map { _meta, f -> f })
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should run without failures - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = BEDTOOLS_GETFASTA.out.fasta.combine(FILTER_MOTIFS.out.motifs.map { _meta, f -> f })
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
