nextflow_process {

    name "Test Process STARE"
    script "modules/local/stare/main.nf"
    process "STARE"

    setup {
        run("PREPARE_GENOME") {
            script "../../../../subworkflows/local/prepare_genome"
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + '/reference/chr1.fa.gz', checkIfExists: true)
                input[1] = file(params.pipelines_testdata_base_path + '/reference/chr1.gtf.gz', checkIfExists: true)
                """
            }
        }

        run("CONVERT_MOTIFS") {
            script "../../motifs/convert_motifs"
            process {
                """
                input[0] = [
                    [ id: 'test' ],
                    file(params.pipelines_testdata_base_path + '/reference/motifs.jaspar', checkIfExists: true),
                    'jaspar'
                ]
                input[1] = 'transfac'
                """
            }
        }

        run("TRANSFAC_TO_PSEM") {
            script "../../motifs/transfac_to_psem"
            process {
                """
                input[0] = CONVERT_MOTIFS.out.converted
                """
            }
        }
    }

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = [
                    [id: 'p6_chromHMM_enhancers', condition: 'p6', assay: 'chromHMM_enhancers'],
                    file(params.pipelines_testdata_base_path + '/intermediates/chromHMM/enhancer/p6.bed', checkIfExists: true)
                ]
                input[1] = PREPARE_GENOME.out.fasta
                input[2] = PREPARE_GENOME.out.gtf
                input[3] = file('https://github.com/nf-core/tfactivity/raw/refs/heads/dev/assets/blacklists/mm10-blacklist.bed', checkIfExists: true)
                input[4] = TRANSFAC_TO_PSEM.out.psem.collect()
                input[5] = 50000
                input[6] = true
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should run without failures - stub") {
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [id: 'p6_chromHMM_enhancers', condition: 'p6', assay: 'chromHMM_enhancers'],
                    file(params.pipelines_testdata_base_path + '/intermediates/chromHMM/enhancer/p6.bed', checkIfExists: true)
                ]
                input[1] = PREPARE_GENOME.out.fasta
                input[2] = PREPARE_GENOME.out.gtf
                input[3] = file('https://github.com/nf-core/tfactivity/raw/refs/heads/dev/assets/blacklists/mm10-blacklist.bed', checkIfExists: true)
                input[4] = TRANSFAC_TO_PSEM.out.psem.collect()
                input[5] = 50000
                input[6] = true
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
