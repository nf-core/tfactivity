nextflow_process {

    name "Test Process FILTER_MOTIFS"
    script "modules/local/motifs/filter_motifs/main.nf"
    process "FILTER_MOTIFS"

    setup {
        run("CONVERT_MOTIFS") {
            script "../../convert_motifs"
            process {
                """
                input[0] = [
                    [ id: 'test' ],
                    file(params.pipelines_testdata_base_path + '/reference/motifs.jaspar', checkIfExists: true),
                    'jaspar'
                ]
                input[1] = 'universal'
                """
            }
        }
    }

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = CONVERT_MOTIFS.out.converted
                input[1] = Channel.from('RUNX1', 'TFAP2A', 'Arnt').collectFile(newLine: true).map { file -> [[id: 'test'], file] }
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should run without failures - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = CONVERT_MOTIFS.out.converted
                input[1] = Channel.from('RUNX1', 'TFAP2A', 'Arnt').collectFile(newLine: true).map { file -> [[id: 'test'], file] }
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
