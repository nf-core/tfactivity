nextflow_process {

    name "Test Process TRANSFAC_TO_PSEM"
    script "modules/local/motifs/transfac_to_psem/main.nf"
    process "TRANSFAC_TO_PSEM"

    setup {
        run("CONVERT_MOTIFS") {
            script "../../convert_motifs"
            process {
                """
                input[0] = [
                    [ id: 'test' ],
                    file(params.pipelines_testdata_base_path + '/reference/motifs.jaspar', checkIfExists: true),
                    'jaspar'
                ]
                input[1] = 'transfac'
                """
            }
        }
    }

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = CONVERT_MOTIFS.out.converted
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should run without failures - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = CONVERT_MOTIFS.out.converted
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
