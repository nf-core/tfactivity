nextflow_process {

    name "Test Process EXTRACT_ID_SYMBOL_MAP"
    script "modules/local/extract_id_symbol_map/main.nf"
    process "EXTRACT_ID_SYMBOL_MAP"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = [
                    [id: "test"],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.gtf', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should run without failures - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [id: "test"],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.gtf', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
