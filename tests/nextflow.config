/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/tfactivity/'
}

aws.client.anonymous = true // fixes S3 access issues on self-hosted runners

process {
    resourceLimits = [
        cpus: 4,
        memory: '10.GB',
        time: '1.h'
    ]

    withName: DESEQ2_DIFFERENTIAL {
        ext.args = { "--round_digits 4 --vs_method rlog" }
    }
}
